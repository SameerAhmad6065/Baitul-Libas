@model TailorBooking.Areas.Admin.ViewModels.AdminBookingDetailsViewModel
@using TailorBooking.Models.Enums

@{
    ViewData["Title"] = "Booking Details";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

    <div>
        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Index"
           class="admin-back-link">
            ← Back to bookings
        </a>

        <h1 class="admin-detail-title">
            Booking Details
        </h1>

        <p class="admin-detail-ref">
            Reference: <span>@Model.Booking.BookingNumber</span>
        </p>
    </div>

    <a href="@Model.WhatsAppUrl"
       target="_blank"
       rel="noopener noreferrer"
       class="admin-whatsapp-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4a11 11 0 0 0-17.5 13L2 22l5.2-1.4A11 11 0 0 0 20 4Zm-8 18a9 9 0 0 1-4.6-1.3l-.3-.2-3 .8.8-2.9-.2-.3A9 9 0 1 1 12 22Zm5-6.7c-.3-.1-1.6-.8-1.8-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1a7.3 7.3 0 0 1-2.2-1.3 8 8 0 0 1-1.5-1.9c-.2-.3 0-.4.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.2-.6-1.5-.9-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4s1 2.8 1.2 3c.1.2 2 3 4.8 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.6-.7 1.9-1.3.2-.6.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3Z" /></svg>
        Contact on WhatsApp
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="admin-alert-success alert alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">

    <div class="col-lg-7">

        <div class="admin-panel mb-4">
            <div class="admin-panel-head">
                <h2>Customer Information</h2>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="admin-field-label">Full Name</div>
                    <div class="admin-field-value admin-field-value--strong">@Model.Booking.CustomerName</div>
                </div>

                <div class="col-md-6">
                    <div class="admin-field-label">Email Address</div>
                    <div class="admin-field-value">
                        <a href="mailto:@Model.Booking.Email" class="admin-inline-link">@Model.Booking.Email</a>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="admin-field-label">WhatsApp Number</div>
                    <div class="admin-field-value">@Model.Booking.WhatsAppNumber</div>
                </div>

                <div class="col-md-6">
                    <div class="admin-field-label">Dubai Area</div>
                    <div class="admin-field-value">@Model.Booking.City</div>
                </div>

                <div class="col-12">
                    <div class="admin-field-label">Complete Address</div>
                    <div class="admin-field-value">@Model.Booking.Address</div>
                </div>

            </div>
        </div>

        <div class="admin-panel">
            <div class="admin-panel-head">
                <h2>Appointment Information</h2>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="admin-field-label">Preferred Date</div>
                    <div class="admin-field-value admin-field-value--strong">
                        @Model.Booking.PreferredDate.ToString("dd MMMM yyyy")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="admin-field-label">Preferred Time</div>
                    <div class="admin-field-value admin-field-value--strong">
                        @Model.Booking.PreferredTime.ToString("hh:mm tt")
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="admin-field-label">Current Status</div>
                    <div class="admin-field-value">
                        <span class="admin-badge admin-badge-gold">@Model.Booking.Status</span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="admin-field-label">Submitted</div>
                    <div class="admin-field-value">
                        @Model.Booking.CreatedAt.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt")
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Booking.Notes))
                {
                    <div class="col-12">
                        <div class="admin-field-label">Customer Notes</div>
                        <div class="admin-notes-box">@Model.Booking.Notes</div>
                    </div>
                }

            </div>
        </div>

    </div>

    <div class="col-lg-5">

        <div class="admin-panel admin-panel--sticky">
            <div class="admin-panel-head">
                <h2>Update Booking</h2>
            </div>

            <form asp-area="Admin"
                  asp-controller="Bookings"
                  asp-action="Update"
                  asp-route-id="@Model.Booking.Id"
                  method="post">

                <input type="hidden" asp-for="Booking.Id" />

                <div asp-validation-summary="ModelOnly" class="admin-alert-danger alert"></div>

                <div class="mb-3">
                    <label asp-for="Status" class="admin-form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<BookingStatus>()"
                            class="form-select admin-form-control">
                    </select>
                    <span asp-validation-for="Status" class="admin-field-error"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="AdminNotes" class="admin-form-label"></label>
                    <textarea asp-for="AdminNotes"
                              class="form-control admin-form-control"
                              rows="6"
                              placeholder="Add private notes for administrators.">
                    </textarea>
                    <span asp-validation-for="AdminNotes" class="admin-field-error"></span>
                    <div class="admin-form-hint">These notes are not visible to customers.</div>
                </div>

                <button type="submit" class="admin-save-btn">
                    Save Changes
                </button>

            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
