@using TailorBooking.Models
@using TailorBooking.Models.Enums

@{
    ViewData["Title"] = "Admin Dashboard";

    List<Booking> recentBookings =
        ViewBag.RecentBookings as List<Booking>
        ?? [];
}

<div class="d-flex flex-column flex-md-row
    justify-content-between align-items-md-center mb-4">

    <div>
        <h1 class="h3 mb-1">
            Admin Dashboard
        </h1>

        <p class="text-muted mb-0">
            Manage customer tailor appointment requests.
        </p>
    </div>

    <a asp-area="Admin"
       asp-controller="Bookings"
       asp-action="Index"
       class="btn btn-primary mt-3 mt-md-0">
        Manage Bookings
    </a>
</div>

<div class="row g-4">

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Total Bookings
                </p>

                <h2 class="mb-0">
                    @ViewBag.TotalBookings
                </h2>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Pending
                </p>

                <h2 class="mb-0">
                    @ViewBag.PendingBookings
                </h2>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Confirmed
                </p>

                <h2 class="mb-0">
                    @ViewBag.ConfirmedBookings
                </h2>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Completed
                </p>

                <h2 class="mb-0">
                    @ViewBag.CompletedBookings
                </h2>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm mt-4">

    <div class="card-header bg-white py-3
        d-flex justify-content-between align-items-center">

        <h2 class="h5 mb-0">
            Recent Bookings
        </h2>

        <a asp-area="Admin"
           asp-controller="Bookings"
           asp-action="Index"
           class="btn btn-sm btn-outline-primary">
            View All
        </a>
    </div>

    <div class="card-body p-0">

        @if (recentBookings.Count == 0)
        {
            <div class="text-center p-5">
                <p class="text-muted mb-0">
                    No bookings have been submitted yet.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">
                                Reference
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Appointment
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end pe-4">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (Booking booking in recentBookings)
                        {
                            <tr>
                                <td class="ps-4">
                                    @booking.BookingNumber
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @booking.CustomerName
                                    </div>

                                    <div class="small text-muted">
                                        @booking.City
                                    </div>
                                </td>

                                <td>
                                    @booking.PreferredDate.ToString(
                                        "dd MMM yyyy")
                                </td>

                                <td>
                                    @booking.Status
                                </td>

                                <td class="text-end pe-4">
                                    <a asp-area="Admin"
                                       asp-controller="Bookings"
                                       asp-action="Details"
                                       asp-route-id="@booking.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        }

    </div>
</div>