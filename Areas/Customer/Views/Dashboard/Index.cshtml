@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h1 class="h3 mb-1">Customer Dashboard</h1>

        <p class="text-muted mb-0">
            Book a tailor and monitor your appointments.
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h5">Book a Tailor</h2>

                <p class="text-muted">
                    Request a tailoring appointment at your
                    preferred date and location.
                </p>

                <button class="btn btn-primary" disabled>
                    Booking Form Coming Next
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <h2 class="h5">My Bookings</h2>

                <p class="text-muted">
                    Review the status and details of your
                    tailor bookings.
                </p>

                <h3 class="display-6">0</h3>
            </div>
        </div>
    </div>
</div>